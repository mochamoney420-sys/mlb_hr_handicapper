# 3. Environment Environment Configurations (Optional)
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# 4. Auto-Healing Health Monitor (24/7 crash detection + auto-fix)
# Status tracking: data/system_health.json
# Recovery log: data/recovery_log.txt
# Runs every 4 hours via Windows Task Scheduler
# Enable with: python health_monitor.py --setup
HEALTH_MONITOR_ENABLED="true"
HEALTH_CHECK_INTERVAL_HOURS="4"

# 5. Morning Market-Release Alert (before HR market correction)
MORNING_BET_ALERT_ENABLED="true"
MORNING_ALERT_START_HOUR_ET="9"
MORNING_ALERT_END_HOUR_ET="11"
MORNING_ALERT_END_MINUTE_ET="0"
MORNING_BET_ALERT_MIN_AMERICAN_ODDS="300"
MORNING_BET_ALERT_MIN_EDGE_ABS="0.02"
MORNING_BET_ALERT_MIN_EV_PCT="2.0"
MORNING_BET_ALERT_MIN_KELLY="0.005"
MORNING_BET_ALERT_TOP_N="8"

# 6. Live odds monitor (+EV + stale-follower lag scan)
RLM_POLL_SECONDS="900"
LIVE_EV_MIN_AMERICAN_ODDS="300"
LIVE_EV_MIN_EDGE_ABS="0.02"
LIVE_EV_REQUIRE_POSITIVE_EDGE="true"
FOLLOWER_STALE_MIN_IMPLIED_GAP="0.015"
SHARP_MOVE_TRIGGER_IMPLIED_DELTA="0.020"

# 7. CLV audit controls
CLV_AUDIT_LOOKBACK_DAYS="30"
CLV_CLOSE_LOOKBACK_MINUTES="90"
CLV_CLOSE_POSTSTART_MINUTES="5"

# 8. Direct API execution (auto-bet)
# Keep dry-run true until your exchange endpoint is verified.
AUTO_WAGER_ENABLED="false"
AUTO_WAGER_DRY_RUN="true"
AUTO_WAGER_ALLOWED_BOOKS="pinnacle,circasports"
AUTO_WAGER_MIN_KELLY="0.01"
AUTO_WAGER_MIN_EDGE_ABS="0.02"
AUTO_WAGER_BANKROLL_USD="1000"
AUTO_WAGER_MIN_STAKE_USD="5"
AUTO_WAGER_MAX_STAKE_USD="50"
AUTO_WAGER_KELLY_MULTIPLIER="0.25"
AUTO_WAGER_HTTP_TIMEOUT_SECONDS="10"
AUTO_WAGER_AUTH_MODE="bearer"
AUTO_WAGER_TOKEN_ENV="AUTO_WAGER_API_TOKEN"
AUTO_WAGER_API_TOKEN=""
AUTO_WAGER_DEFAULT_URL=""
AUTO_WAGER_BOOK_CONFIG_JSON=""

# 9. Shadow model paper trading
SHADOW_MODEL_ENABLED="true"
